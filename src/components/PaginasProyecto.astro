---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import VideoProyecto from './VideoProyecto.astro';

interface Props {
  carpeta: string; // ej. "/src/content/proyectos/bzero"
  alt: string;
  video?: string; // si hay, va como primera lámina
  poster?: string;
  contador?: boolean; // false: solo flechas, sin "1 / N"
  autoplay?: boolean; // el video parte solo, en loop y sin sonido
}

const { carpeta, alt, video, poster, contador = true, autoplay = false } = Astro.props;

// Láminas: <carpeta>/paginas/p-01.jpg, p-02.jpg, … (páginas de PDF u otras imágenes)
const todas = import.meta.glob<ImageMetadata>('/src/content/proyectos/*/paginas/*.jpg', {
  import: 'default',
  eager: true,
});
const paginas = Object.keys(todas)
  .filter((ruta) => ruta.startsWith(`${carpeta}/paginas/`))
  .sort()
  .map((ruta) => todas[ruta]);
if (paginas.length === 0) throw new Error(`No hay páginas en ${carpeta}/paginas/`);
const total = paginas.length + (video ? 1 : 0);
const desfase = video ? 1 : 0;
---

<div class="paginas" data-paginas>
  <div class="paginas__tira" tabindex="0" role="region" aria-roledescription="carrusel" aria-label={alt}>
    {
      video && (
        <div class="paginas__pagina" role="group" aria-label={`Página 1 de ${total}`}>
          <VideoProyecto src={video} poster={poster} alt={alt} autoplay={autoplay} />
        </div>
      )
    }
    {
      paginas.map((pagina, i) => (
        <div class="paginas__pagina" role="group" aria-label={`Página ${i + 1 + desfase} de ${total}`}>
          <Image
            src={pagina}
            alt={`${alt} — página ${i + 1 + desfase}`}
            widths={[720, 1280]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
  <button class="paginas__flecha paginas__flecha--anterior display" type="button" aria-label="Página anterior" hidden>
    ←
  </button>
  <button class="paginas__flecha paginas__flecha--siguiente display" type="button" aria-label="Página siguiente" hidden>
    →
  </button>
  {
    contador && (
      <p class="paginas__contador display" aria-live="polite" hidden>
        <span data-actual>1</span> / {total}
      </p>
    )
  }
</div>

<script>
  // Sin JS, la tira se recorre con scroll horizontal; con JS aparecen flechas y contador (si lo hay).
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-paginas]')) {
    const tira = raiz.querySelector<HTMLElement>('.paginas__tira')!;
    const anterior = raiz.querySelector<HTMLButtonElement>('.paginas__flecha--anterior')!;
    const siguiente = raiz.querySelector<HTMLButtonElement>('.paginas__flecha--siguiente')!;
    const contador = raiz.querySelector<HTMLElement>('.paginas__contador');
    const actual = raiz.querySelector<HTMLElement>('[data-actual]');
    const total = tira.children.length;

    const indice = () => Math.round(tira.scrollLeft / tira.clientWidth);

    const refrescar = () => {
      const i = indice();
      // Un video que queda fuera de vista se pausa.
      [...tira.children].forEach((pagina, n) => {
        if (n !== i) pagina.querySelector('video')?.pause();
      });
      if (actual) actual.textContent = String(i + 1);
      anterior.disabled = i === 0;
      siguiente.disabled = i === total - 1;
    };

    const ir = (delta: number) => {
      const destino = Math.min(total - 1, Math.max(0, indice() + delta));
      tira.scrollTo({ left: destino * tira.clientWidth, behavior: reducido.matches ? 'auto' : 'smooth' });
    };

    anterior.addEventListener('click', () => ir(-1));
    siguiente.addEventListener('click', () => ir(1));
    tira.addEventListener('scroll', refrescar, { passive: true });

    raiz.classList.add('paginas--js');
    anterior.hidden = siguiente.hidden = false;
    if (contador) contador.hidden = false;
    refrescar();
  }
</script>

<style>
  .paginas {
    position: relative;
  }

  .paginas__tira {
    display: flex;
    width: 100%;
    aspect-ratio: var(--proporcion-imagen);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
  }

  /* Con JS se navega con las flechas: sin barra de scroll en ningún navegador. */
  .paginas--js .paginas__tira {
    scrollbar-width: none;
  }

  .paginas--js .paginas__tira::-webkit-scrollbar {
    display: none;
  }

  .paginas__pagina {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  /* display: block evita el espacio bajo la imagen (elemento en línea) que hacía
     la página más alta que el recuadro y agregaba scroll vertical. */
  .paginas__pagina :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .paginas__flecha {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    font-size: var(--fs-flecha-paginas);
    line-height: var(--lh-indicador);
  }

  .paginas__flecha--anterior {
    left: 0;
  }

  .paginas__flecha--siguiente {
    right: 0;
  }

  .paginas__flecha:disabled {
    visibility: hidden;
  }

  .paginas__contador {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    font-size: var(--fs-subtitulo);
    line-height: var(--lh-subtitulo);
    pointer-events: none; /* no tapa los controles del video */
  }

  .paginas__flecha[hidden],
  .paginas__contador[hidden] {
    display: none;
  }
</style>
